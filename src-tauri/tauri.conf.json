{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenLens",
  "version": "1.2.4",
  "identifier": "com.kjuan.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTk0RTYzREJEMTQ4NEUKUldST1NOSGJZMDZwUStTWWgvRVM3VVJRUy9zdGdUY2toN0wrSjlCWElXNVlJTkVSUmJJc2VhR2oK",
      "endpoints": [
        "https://github.com/pyyxzi/tokenlens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Local AI token usage analytics",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "externalBin": [
      "binaries/tokenlens-service"
    ]
  }
}
